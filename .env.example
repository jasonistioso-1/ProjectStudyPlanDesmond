# PT3 Solutions — Study Plan Repository (SPR) Environment Variables
# Copy this template to .env and configure for your local/production environment

# Application Server Port
PORT=5000
NODE_ENV=production

# Database Connection (MySQL 8.0 / PostgreSQL 15)
DB_HOST=localhost
DB_PORT=3306
DB_USER=spr_user
DB_PASSWORD=your_secure_password_here
DB_NAME=spr_db

# Frontend Client Origin (CORS Configuration)
CLIENT_ORIGIN=http://localhost:3000

# Optional Logging Level (debug | info | warn | error)
LOG_LEVEL=info
